<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--Texto-->
    <style name="TextAppearance.RutinApp.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
    </style>
    <style name="TextAppearance.RutinApp.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.RutinApp.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.RutinApp.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TextAppearance.RutinApp.Section" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.RutinApp.Section" parent="">
        <item name="android:textAppearance">@style/TextAppearance.RutinApp.Section</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_m</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
    </style>
    <style name="Widget.RutinApp.Weekday" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">@dimen/space_s</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!--Botones-->
    <style name="Widget.RutinApp.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_card</item>
        <item name="backgroundTint">@color/primary</item>
    </style>
    <style name="Widget.RutinApp.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_card</item>
        <item name="strokeColor">@color/border</item>
        <item name="android:textColor">@color/primary</item>
    </style>
    <style name="Widget.RutinApp.Button.Outlined.Danger">
        <item name="strokeColor">@color/danger</item>
        <item name="android:textColor">@color/danger</item>
    </style>
    <style name="Widget.RutinApp.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary</item>
    </style>
    <style name="Widget.RutinApp.Button.Text.Danger">
        <item name="android:textColor">@color/danger</item>
    </style>
    <style name="Widget.RutinApp.Button.Text.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <!-- Botón tipo píldora -->
    <style name="Widget.RutinApp.Button.Pill" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">200dp</item>
        <item name="iconTint">@color/primary</item>
        <item name="android:layout_marginTop">@dimen/space_s</item>
    </style>
    <style name="Widget.RutinApp.IconButton" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/text_secondary</item>
    </style>

    <!--Campos-->
    <style name="Widget.RutinApp.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_field</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_field</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_field</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_field</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
    </style>
    <style name="Widget.RutinApp.SwitchField" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingHorizontal">@dimen/space_m</item>
        <item name="android:paddingVertical">@dimen/space_s</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ===== Tarjetas, chips, badges ===== -->
    <style name="Widget.RutinApp.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.RutinApp.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Widget.RutinApp.Dot" parent="">
        <item name="android:layout_width">@dimen/routine_dot</item>
        <item name="android:layout_height">@dimen/routine_dot</item>
        <item name="android:background">@drawable/shape_dot</item>
    </style>
    <style name="Widget.RutinApp.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconVisible">false</item>
    </style>
    <style name="Widget.RutinApp.Chip.Day">
        <item name="android:minWidth">44dp</item>
        <item name="android:layout_width">44dp</item>
        <item name="android:textAlignment">center</item>
        <item name="chipStartPadding">0dp</item>
        <item name="chipEndPadding">0dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
        <item name="chipCornerRadius">22dp</item>
        <item name="chipMinHeight">44dp</item>
        <item name="chipMinTouchTargetSize">44dp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.RutinApp.ColorOption" parent="">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/shape_dot</item>
        <item name="android:foreground">@drawable/fg_color_selected</item>
    </style>
</resources>
